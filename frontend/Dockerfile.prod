# Stage 1: Build
FROM node:22-alpine AS builder

RUN apk upgrade --no-cache

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

RUN apk upgrade --no-cache

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template outside /etc/nginx/templates/
COPY nginx.conf /etc/nginx/nginx.conf.template

# Remove default configs that ship with nginx:alpine
RUN rm -f /etc/nginx/conf.d/default.conf

# Railway uses PORT env var — default to 80
ENV PORT=80
ENV BACKEND_URL=http://backend:3000

EXPOSE ${PORT}

# Override entrypoint to skip nginx:alpine's built-in envsubst
# (it replaces ALL $ variables, destroying nginx's $host, $uri, etc.)
ENTRYPOINT []
CMD ["sh", "-c", "envsubst '$BACKEND_URL $PORT' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
