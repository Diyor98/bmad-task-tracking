# Stage 1: Build
FROM node:22-alpine AS builder

RUN apk upgrade --no-cache

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

RUN apk upgrade --no-cache

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config template (NOT in /etc/nginx/templates/ to avoid
# nginx:alpine's built-in envsubst which replaces ALL $ variables
# including nginx's own $host, $uri, etc.)
COPY nginx.conf /etc/nginx/nginx.conf.template

# Railway uses PORT env var — default to 80
ENV PORT=80
ENV BACKEND_URL=http://backend:3000

EXPOSE ${PORT}

# envsubst replaces only ${BACKEND_URL} and ${PORT}, preserving nginx variables
CMD sh -c "envsubst '\$BACKEND_URL \$PORT' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"
